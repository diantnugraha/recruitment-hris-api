generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
  email           String    @unique @db.VarChar(100)
  password        String    @db.VarChar(255)
  displayName     String    @map("display_name") @db.VarChar(100)
  roleId          Int       @map("role_id")
  employeeId      Int?      @unique @map("employee_id")
  superiorId      Int?      @map("superior_id")
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  emailVerifiedAt DateTime? @map("email_verified_at")
  userImei        String?   @map("user_imei") @db.VarChar(100)
  created_at      DateTime? @default(now())
  updated_at      DateTime?
  trash           DateTime? @map("deleted_at")

  role     Role      @relation(fields: [roleId], references: [roleId])
  employee Employee? @relation(fields: [employeeId], references: [employeeId])
  files    UserFile[]

  employeeRequests        EmployeeRequest[]
  employeeRequestComments EmployeeRequestComment[]
  notifications           Notification[]

  hodReviewedRequests      EmployeeRequest[] @relation("HodReviewer")
  hrReviewedRequests       EmployeeRequest[] @relation("HrReviewer")
  approvedRequests         EmployeeRequest[] @relation("Approver")
  revisedRequests          EmployeeRequest[] @relation("Reviser")
  rejectedRequests         EmployeeRequest[] @relation("Rejecter")

  @@index([roleId], map: "roletouser_idx")
  @@map("users")
}

model Role {
  roleId   Int     @id @default(autoincrement()) @map("role_id")
  roleName String? @map("role_name") @db.VarChar(45)

  users User[]

  @@map("role_access")
}

model Employee {
  employeeId            Int       @id @default(autoincrement()) @map("employee_id")
  uuid                  String    @unique @db.Char(36)
  superiorId            Int       @default(0) @map("superior_id")
  jobTitleId            BigInt?   @map("job_title_id") @db.UnsignedBigInt
  departmentId          Int?      @map("department_id")
  employeeImages        String?   @map("employee_images") @db.VarChar(255)
  employeeBu            String?   @map("employee_bu") @db.VarChar(100)
  employeeExt           String?   @map("employee_ext") @db.VarChar(50)
  employeeGender        String?   @map("employee_gender") @db.VarChar(10)
  employeeNickname      String?   @map("employee_nickname") @db.VarChar(50)
  employeeNik           String?   @map("employee_nik") @db.VarChar(50)
  employeeName          String    @map("employee_name") @db.VarChar(255)
  employeeContact       String?   @map("employee_contact") @db.VarChar(50)
  employeeEmail         String?   @map("employee_email") @db.VarChar(100)
  employeeTitle         String?   @map("employee_title") @db.VarChar(100)
  employeeStatus        String    @map("employee_status") @db.VarChar(45)
  employeeJoindate      DateTime? @map("employee_joindate")
  employeeBirthdate     DateTime? @map("employee_birthdate")
  employeePermanentdate DateTime? @map("employee_permanentdate")
  employeeLocation      String?   @map("employee_location") @db.VarChar(100)
  employeeMaritalstatus String?   @map("employee_maritalstatus") @db.VarChar(50)
  employeeAddress       String?   @map("employee_alamat") @db.VarChar(255)
  employeeReligion      String?   @map("employee_religion") @db.VarChar(50)
  employeeEthnic        String?   @map("employee_ethnic") @db.VarChar(50)
  employeeNationality   String?   @map("employee_nationality") @db.VarChar(50)
  employeeMother        String?   @map("employee_mother") @db.VarChar(100)
  employeeFather        String?   @map("employee_father") @db.VarChar(100)
  employeeSpouse        String?   @map("employee_spouse") @db.VarChar(100)
  employeeEmgName       String?   @map("employee_emg_name") @db.VarChar(200)
  employeeEmgRel        String?   @map("employee_emg_rel") @db.VarChar(45)
  employeeEmgPhone      String?   @map("employee_emg_phone") @db.VarChar(45)
  employeeTrash         Int?      @map("employee_trash")
  employeeSign          String?   @map("employee_sign") @db.VarChar(255)

  // Relations
  user       User?
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  // Structural positions (inverse relations)
  headOfDivisions    Division[]   @relation("HeadOfDivision")
  deputyOfDivisions  Division[]   @relation("DeputyHead")
  managedDepartments Department[] @relation("DepartmentManager")

  @@index([jobTitleId])
  @@index([departmentId])
  @@map("employee_list")
}

model UserFile {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  name      String    @db.VarChar(255)
  type      String    @db.VarChar(50)
  location  String    @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("user_files")
}

// Organizational Breakdown Structure (Business Unit)
model Obs {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  cluster     String?   @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  divisions Division[]

  @@index([name])
  @@index([cluster])
  @@map("obs")
}

model Division {
  id               Int       @id @default(autoincrement())
  obsId            BigInt?   @map("obs_id") @db.UnsignedBigInt
  name             String    @db.VarChar(255)
  code             String?   @db.VarChar(50)
  isManagement     Boolean   @default(false) @map("is_management")
  headOfDivisionId Int?      @unique @map("head_of_division_id")
  deputyHeadId     Int?      @unique @map("deputy_head_id")
  description      String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  obs            Obs?         @relation(fields: [obsId], references: [id])
  headOfDivision Employee?    @relation("HeadOfDivision", fields: [headOfDivisionId], references: [employeeId])
  deputyHead     Employee?    @relation("DeputyHead", fields: [deputyHeadId], references: [employeeId])
  departments    Department[]
  jobTitles      JobTitle[]

  @@index([name])
  @@index([code])
  @@index([obsId])
  @@index([isManagement])
  @@map("divisions")
}

model Department {
  id          Int       @id @default(autoincrement())
  divisionId  Int       @map("division_id")
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(100)
  managerId   Int?      @unique @map("manager_id")
  category    String?   @db.VarChar(50)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  division         Division             @relation(fields: [divisionId], references: [id])
  manager          Employee?            @relation("DepartmentManager", fields: [managerId], references: [employeeId])
  jobTitles        DepartmentJobTitle[]
  employeeBudgets  EmployeeBudget[]
  employees        Employee[]
  employeeRequests EmployeeRequest[]

  @@index([divisionId])
  @@map("departments")
}

enum JobLevelCategory {
  Functional
  Structural
}

model JobLevel {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name              String           @unique @db.Char(100)
  code              String?          @unique @db.VarChar(50)
  category          JobLevelCategory
  description       String?          @db.Text
  canCreateJobTitle Boolean          @default(false) @map("can_create_job_title")
  canCreateKpi      Boolean          @default(false) @map("can_create_kpi")
  order             Int?
  createdAt         DateTime?        @default(now()) @map("created_at")
  updatedAt         DateTime?        @map("updated_at")

  jobTitles JobTitle[]

  @@index([name])
  @@index([code])
  @@index([category])
  @@map("job_levels")
}

enum JobTitleType {
  Administration
  Technical
}

model JobTitle {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name           String        @unique @db.Char(100)
  jobLevelId     BigInt        @map("job_level_id") @db.UnsignedBigInt
  divisionId     Int?          @map("division_id")
  directReportId BigInt?       @map("direct_report_id") @db.UnsignedBigInt
  description    String?       @db.Text
  purpose        String?       @db.Text
  requirement    String?       @db.Text
  type           JobTitleType?
  createdAt      DateTime?     @default(now()) @map("created_at")
  updatedAt      DateTime?     @map("updated_at")

  jobLevel     JobLevel   @relation(fields: [jobLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  division     Division?  @relation(fields: [divisionId], references: [id])
  directReport JobTitle?  @relation("DirectReport", fields: [directReportId], references: [id])
  subordinates JobTitle[] @relation("DirectReport")

  departments DepartmentJobTitle[]
  employees   Employee[]

  @@index([jobLevelId])
  @@index([directReportId])
  @@index([divisionId])
  @@index([name])
  @@map("job_titles")
}

model DepartmentJobTitle {
  jobTitleId   BigInt @map("job_title_id") @db.UnsignedBigInt
  departmentId Int    @map("department_id")

  jobTitle   JobTitle   @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([jobTitleId, departmentId])
  @@index([jobTitleId])
  @@index([departmentId])
  @@map("department_job_title")
}

model EmployeeBudget {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  departmentId Int       @map("department_id")
  year         Int
  technical    Int
  admin        Int
  document     String?   @db.Text
  documentName String?   @map("document_name") @db.VarChar(255)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(0)

  department Department @relation(fields: [departmentId], references: [id])

  @@map("employee_budget")
}

enum EmployeeRequestGender {
  M
  F
  A
}

model EmployeeRequest {
  id                    BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  code                  String                @db.VarChar(255)
  jobTitleId            Int                   @map("job_title_id")
  purpose               String                @db.Text
  reason                String                @db.Text
  generalJobPurpose     String                @map("general_job_purpose") @db.Text
  jobDescription        String                @map("job_description") @db.Text
  jobRequirement        String                @map("job_requirement") @db.Text
  statusEmployeeRequest Int                   @map("status_employee_request")
  statusRecruitment     Int                   @map("status_recruitment")
  codeRecruitment       String                @map("code_recruitment") @db.VarChar(30)
  gender                EmployeeRequestGender @default(M)
  ageFrom               Int                   @map("age_from")
  ageTo                 Int                   @map("age_to")
  expectedOnboardDate   DateTime              @map("expected_onboard_date") @db.Date
  jobPlacement          String                @map("job_placement") @db.VarChar(30)
  isDeleted             Int                   @map("is_deleted")
  createdBy             Int                   @map("created_by")
  education             String                @db.VarChar(50)
  experience            String                @db.VarChar(50)
  budget                String                @db.VarChar(50)
  approvedAt            DateTime?             @map("approved_at") @db.Timestamp(0)
  createdAt             DateTime?             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime?             @map("updated_at") @db.Timestamp(0)
  departmentId          Int?                  @map("department_id")
  hodReviewedBy         Int?                  @map("hod_reviewed_by")
  hodReviewedAt         DateTime?             @map("hod_reviewed_at") @db.Timestamp(0)
  hrReviewedBy          Int?                  @map("hr_reviewed_by")
  hrReviewedAt          DateTime?             @map("hr_reviewed_at") @db.Timestamp(0)
  approvedBy            Int?                  @map("approved_by")
  revisedBy             Int?                  @map("revised_by")
  revisedAt             DateTime?             @map("revised_at") @db.Timestamp(0)
  rejectedBy            Int?                  @map("rejected_by")
  rejectedAt            DateTime?             @map("rejected_at") @db.Timestamp(0)
  recruitmentStartedAt  DateTime?             @map("recruitment_started_at") @db.Timestamp(0)

  createdByUser User                     @relation(fields: [createdBy], references: [id])
  comments      EmployeeRequestComment[]
  department    Department?              @relation(fields: [departmentId], references: [id])
  hodReviewer   User?                    @relation("HodReviewer", fields: [hodReviewedBy], references: [id])
  hrReviewer    User?                    @relation("HrReviewer", fields: [hrReviewedBy], references: [id])
  approver      User?                    @relation("Approver", fields: [approvedBy], references: [id])
  reviser       User?                    @relation("Reviser", fields: [revisedBy], references: [id])
  rejecter      User?                    @relation("Rejecter", fields: [rejectedBy], references: [id])

  @@map("employee_request")
}

model EmployeeRequestComment {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employeeRequestId BigInt    @map("employee_request_id") @db.UnsignedBigInt
  userId            Int       @map("user_id")
  comment           String    @db.Text
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(0)

  employeeRequest EmployeeRequest @relation(fields: [employeeRequestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@index([employeeRequestId])
  @@index([userId])
  @@map("employee_request_comment")
}

model Notification {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId        Int       @map("user_id")
  type          String    @db.VarChar(50)
  title         String    @db.VarChar(255)
  message       String    @db.Text
  referenceType String?   @map("reference_type") @db.VarChar(50)
  referenceId   BigInt?   @map("reference_id") @db.UnsignedBigInt
  isRead        Boolean   @default(false) @map("is_read")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([referenceType, referenceId, type, userId])
  @@index([userId])
  @@index([userId, isRead])
  @@map("notification")
}

enum CandidateVerify {
  NOT_VERIFIED @map("0")
  VERIFIED     @map("1")
}

enum CandidateGender {
  M
  F
}

model CandidateRecruitment {
  id                  BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  verify              CandidateVerify
  token               String           @db.Text
  email               String           @db.VarChar(32)
  fullname            String           @db.VarChar(255)
  address             String           @db.Text
  resident_status     String           @db.VarChar(32)
  birth_place         String           @db.VarChar(32)
  birth_date          DateTime?        @db.Date
  religion            String           @db.VarChar(32)
  ethnic_group        String?          @db.VarChar(32)
  id_no               String           @db.VarChar(32)
  tax_id              String           @db.VarChar(32)
  bpjs_id             String           @db.VarChar(32)
  citizenship         String           @db.VarChar(32)
  marrital_status     String           @db.VarChar(32)
  gender              CandidateGender?
  mobile_phone        String           @db.VarChar(32)
  domicile_address    String?          @db.Text
  driving_license     String           @db.VarChar(32)
  document_1          String           @db.Text
  document_2          String           @db.Text
  uniform_shirt_size  String?          @db.VarChar(10)
  uniform_pants_size  String?          @db.VarChar(10)
  agreementAcceptedAt DateTime?        @map("agreement_accepted_at") @db.Timestamp(0)
  agreementVersion    String?          @map("agreement_version") @db.VarChar(20)
  createdAt           DateTime?        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime?        @map("updated_at") @db.Timestamp(0)

  @@map("candidate_recruitment")
}

enum CandidateDetailVerify {
  NOT_VERIFIED @map("0")
  VERIFIED     @map("1")
}

model candidate_recruitment_detail {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  candidate_id        Int
  job_title_id        Int
  createdAt           DateTime?             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime?             @map("updated_at") @db.Timestamp(0)
  candidate_code      String                @db.VarChar(30)
  candidate_token     String                @db.Text
  candidate_verify    CandidateDetailVerify
  employee_request_id String                @db.Text
  invited_by          Int?                  @map("invited_by")

  @@map("candidate_recruitment_detail")
}

enum AssessmentStatus {
  PENDING @map("0")
  PASSED  @map("1")
  FAILED  @map("2")
}

model candidate_recruitment_assessment {
  id                              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  candidate_id                    Int
  candidate_recruitment_detail_id Int
  interview1_desc                 String           @db.Text
  interview1_status               AssessmentStatus
  interview2_desc                 String           @db.Text
  interview2_status               AssessmentStatus
  mcu_desc                        String           @db.Text
  mcu_status                      AssessmentStatus
  reason_to_move                  String           @db.Text
  purpose_of_applying             String           @db.Text
  last_salary                     String           @db.VarChar(30)
  active_language                 String           @db.VarChar(30)
  loyality                        String           @db.VarChar(30)
  when_ready_work                 String           @db.VarChar(30)
  ref_contact_name                String           @db.VarChar(30)
  last_job_description            String           @db.Text
  tasks_jobs                      String           @db.Text
  expected_salary                 String           @db.VarChar(30)
  rotate_work                     String           @db.VarChar(30)
  employees_you_know              String           @db.VarChar(30)
  relationship_with_the_employee  String           @db.VarChar(30)
  ref_mobile_phone                String           @db.VarChar(30)
  createdAt                       DateTime?        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                       DateTime?        @map("updated_at") @db.Timestamp(0)
  assessment_assigned_to          String           @db.VarChar(50)
  interview_started_at            DateTime?        @map("interview_started_at") @db.Timestamp(0)
  interview_date                  DateTime?        @map("interview_date") @db.Timestamp(0)
  interview_type                  InterviewType?   @map("interview_type")
  mcu_document_url                String?          @map("mcu_document_url") @db.VarChar(500)
  mcu_document_name               String?          @map("mcu_document_name") @db.VarChar(255)
  mcu_date                        DateTime?        @map("mcu_date") @db.Timestamp(0)
  mcu_location                    String?          @map("mcu_location") @db.VarChar(255)

  scoring   candidate_assessment_scoring[]
  assignees candidate_assessment_assignee[]

  @@map("candidate_recruitment_assessment")
}

enum InterviewType {
  ONLINE @map("online")
  ONSITE @map("onsite")
}

enum InterviewStage {
  INTERVIEW1 @map("interview1")
  INTERVIEW2 @map("interview2")
}

enum AssessmentConclusion {
  PROCEED     @map("proceed")
  RECOMMENDED @map("recommended")
  REJECTED    @map("rejected")
}

model candidate_assessment_scoring {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  assessment_id BigInt         @db.UnsignedBigInt
  stage         InterviewStage

  // Scoring criteria (1-5 scale)
  relevance_of_experience   Int @db.TinyInt
  training_undertaken       Int @db.TinyInt
  technical_skills          Int @db.TinyInt
  non_technical_skills      Int @db.TinyInt
  communication_skills      Int @db.TinyInt
  emotional_maturity        Int @db.TinyInt
  understanding_of_position Int @db.TinyInt
  teamwork_ability          Int @db.TinyInt
  total_score               Int @db.TinyInt

  // Conclusion
  conclusion AssessmentConclusion

  // Rich text (Lexical JSON)
  key_competencies  Json? @db.Json
  interviewer_notes Json? @db.Json

  // Audit
  assessed_by String?   @db.VarChar(50)
  assessed_at DateTime? @db.Timestamp(0)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  assessment candidate_recruitment_assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, stage])
  @@index([assessment_id])
  @@index([stage])
  @@index([conclusion])
  @@index([total_score])
  @@map("candidate_assessment_scoring")
}

// Junction table for multiple assessors assigned to an assessment
model candidate_assessment_assignee {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  assessment_id BigInt   @db.UnsignedBigInt
  employee_id   Int      @db.UnsignedInt
  assigned_at   DateTime @default(now()) @db.Timestamp(0)

  assessment candidate_recruitment_assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, employee_id])
  @@index([assessment_id])
  @@index([employee_id])
  @@map("candidate_assessment_assignee")
}

model candidate_recruitment_onboarding {
  id                              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  candidate_id                    Int
  employee_request_id             Int
  candidate_recruitment_detail_id Int
  job_placement                   String    @db.VarChar(30)
  document                        String    @db.VarChar(100)
  createdAt                       DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                       DateTime? @map("updated_at") @db.Timestamp(0)
  document_candidate              String    @db.Text
  onboardingAcceptedAt            DateTime? @map("onboarding_accepted_at") @db.Timestamp(0)
  onboardingSentAt                DateTime? @map("onboarding_sent_at") @db.Timestamp(0)
  join_date                       String?   @db.VarChar(20)

  @@map("candidate_recruitment_onboarding")
}

model facillities {
  id                                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  inventory_no                        String    @db.VarChar(255)
  item                                String    @db.VarChar(255)
  qty                                 Int       @default(1)
  unit                                String    @db.VarChar(50)
  condition                           String    @db.VarChar(50)
  status                              String    @db.VarChar(50)
  created_at                          DateTime? @default(now()) @db.Timestamp(0)
  updated_at                          DateTime? @db.Timestamp(0)
  candidate_recruitment_onboarding_id Int

  pics                                facility_pics[]

  @@unique([inventory_no])
  @@index([candidate_recruitment_onboarding_id])
  @@map("facillities")
}

model facility_pics {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  facility_id BigInt   @db.UnsignedBigInt
  employee_id Int
  created_at  DateTime? @default(now()) @db.Timestamp(0)

  facility    facillities @relation(fields: [facility_id], references: [id], onDelete: Cascade)

  @@index([facility_id])
  @@index([employee_id])
  @@map("facility_pics")
}

model program_pics {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  program_id BigInt   @db.UnsignedBigInt
  employee_id Int
  created_at DateTime? @default(now()) @db.Timestamp(0)

  program    OnboardingProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@index([program_id])
  @@index([employee_id])
  @@map("program_pics")
}

model OnboardingProgram {
  id                                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  candidate_recruitment_onboarding_id Int
  program                             String    @db.VarChar(255)
  date                                String    @db.VarChar(50)
  location                            String    @db.VarChar(255)
  pic_legacy                          String    @map("pic") @db.VarChar(255)
  status                              String    @db.VarChar(50)
  createdAt                           DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                           DateTime? @map("updated_at") @db.Timestamp(0)

  pics                                program_pics[]

  @@index([candidate_recruitment_onboarding_id])
  @@map("onboarding_program")
}

model candidate_recruitment_educational_background {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  candidate_id      Int
  school_university String    @db.VarChar(50)
  city              String    @db.VarChar(50)
